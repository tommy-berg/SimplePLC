# Generates a C++ source with the contents of the files listed in MANIFEST
# ("logical/path=/absolute/path" per line) for simpleplc::embedded.
#
#   cmake -DMANIFEST=manifest.txt -DOUTPUT=embedded_files.cpp -P EmbedFiles.cmake

file(STRINGS "${MANIFEST}" entries)
set(arrays "")
set(table "")
set(index 0)
foreach(entry IN LISTS entries)
    string(FIND "${entry}" "=" eq)
    string(SUBSTRING "${entry}" 0 ${eq} logical)
    math(EXPR start "${eq} + 1")
    string(SUBSTRING "${entry}" ${start} -1 physical)

    file(READ "${physical}" hex HEX)
    string(LENGTH "${hex}" hexLength)
    math(EXPR size "${hexLength} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Line breaks every 32 bytes keep the generated file readable for compilers and editors
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
    if(size EQUAL 0)
        set(bytes "0x00")
    endif()

    string(APPEND arrays "alignas(8) const unsigned char f${index}[] = {\n${bytes}\n};\n")
    string(APPEND table "    {\"${logical}\", f${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()

set(content "// Generated by cmake/EmbedFiles.cmake. Do not edit.
#include \"app/embedded.h\"

#include <algorithm>

namespace simpleplc::embedded {
namespace {
${arrays}
const File kFiles[] = {
${table}};
}  // namespace

std::span<const File> all() { return kFiles; }

const File* find(std::string_view path) {
    for (const File& f : kFiles) {
        if (f.path == path) return &f;
    }
    return nullptr;
}

}  // namespace simpleplc::embedded
")

# Only rewrite when the content changed, so unchanged assets do not trigger a rebuild
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
